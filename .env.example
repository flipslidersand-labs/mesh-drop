# Vault Configuration (Recommended)
# Store secrets: vault kv put secret/github-pat token='your_pat_here'
VAULT_ADDR=https://localhost:8200
VAULT_TOKEN=your_vault_root_token

# GitHub CLI Configuration (Fallback if Vault not available)
GITHUB_TOKEN=your_github_pat_here

# Discord Webhook (for notifications)
# Create server → channel → webhook at Discord Developer Portal
# Store in Vault: vault kv put secret/discord-webhook url='https://...'
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Discord Webhook for Haiku Decompose Batch (MINIPC cron)
# Store in Vault: vault kv put secret/discord-webhook-decompose url='https://...'
DISCORD_WEBHOOK_DECOMPOSE=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Gmail API (for mail-manager Phase 2)
# Setup: console.cloud.google.com → Enable Gmail API → OAuth 2.0 credentials (Desktop app)
# Add redirect URI: http://localhost:8080/callback
# Auth: pnpm mail:gmail-auth
GMAIL_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=YOUR_CLIENT_SECRET

# MINIPC Settings
# 内部 IP とユーザー名は env で管理する（このファイルに実値を書かない）
MINIPC_HOST=
MINIPC_USER=
MINIPC_SSH_KEY=~/.ssh/id_ed25519_minipc

# Prometheus (for monitoring)
PROMETHEUS_URL=http://localhost:9090

# doc-ingest Ollama backends (distill.py)
# カンマ区切りで複数指定可。フォールバックチェーンとして順番に試行する。
# 省略時は localhost:11434 のみ使用（内部 IP はここに書かず env で管理する）
OLLAMA_BACKENDS=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OTel Collector
OTEL_COLLECTOR_ENDPOINT=http://localhost:4319
OTEL_AUTH_TOKEN=dummy

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
